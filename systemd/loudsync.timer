[Unit]
Description=loudsync safety net: check every minute whether a full pass is due
Documentation=https://github.com/overdose9/loudsync

[Timer]
# The watcher is what makes syncing fast: it uploads what you save and asks
# the remote for changes every few seconds. This timer is what makes it
# dependable: if the watcher is not running, or missed something, a pass
# still happens. Each tick runs "loudsync --if-needed", which decides.
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=10s
# If the machine was off, sync on boot instead of waiting for the next slot.
Persistent=true

[Install]
WantedBy=timers.target
