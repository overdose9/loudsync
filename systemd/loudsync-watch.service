[Unit]
Description=loudsync watcher — uploads what you save and polls the remote for changes
Documentation=https://github.com/overdose9/loudsync
After=network-online.target

[Service]
Type=simple
ExecStart=@BINDIR@/loudsync-watch
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
