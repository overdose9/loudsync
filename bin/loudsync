#!/usr/bin/env bash
#
# loudsync — two-way sync between a local folder and any rclone remote.
#
# Three things it does that generic sync tools don't:
#
#   1. Git repositories are detected on every run and excluded. Their backup is
#      the remote you already push to. Two-way syncing a .git/ directory
#      corrupts the index and the object store when both sides write, or when
#      an upload is cut halfway through.
#
#   2. Secrets are excluded by filename before the first upload, not after the
#      incident. See the shipped filter file.
#
#   3. It is loud. A backup that fails silently is worse than no backup,
#      because it buys you confidence you haven't earned. That includes
#      conflicts: rclone resolves them, exits 0, and tells nobody.
#
# Usage:
#   loudsync                    normal run (this is what systemd calls)
#   loudsync --resync           first run, or to rebuild sync state
#   loudsync --dry-run          show what would happen, change nothing
#   loudsync --propagate-rename you renamed a folder containing a git repo
#   loudsync --now              sync even if the folder is being written to
#   loudsync --status           show current state and exit
#
# Any other flag is passed straight through to `rclone bisync`.
#
# Copyright (C) 2026 Sebastián Flores
# Licensed under the GNU General Public License v3.0 or later.

set -euo pipefail

VERSION="0.4.0"

# --- Configuration ----------------------------------------------------------
#
# Everything below can be overridden from the config file. Only LOCAL_DIR and
# REMOTE are required; the rest have defaults that suit a laptop.

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}/loudsync"
STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}/loudsync"
CONFIG_FILE="${LOUDSYNC_CONFIG:-${CONFIG_HOME}/loudsync.conf}"

LOCAL_DIR=""
REMOTE=""
RCLONE_BIN=""
FILTERS_BASE="${CONFIG_HOME}/filters-base.txt"
MAX_DELETE_PERCENT=50   # bisync reads this as a percentage, not a file count
CONFLICT_RESOLVE="newer"
KEEP_LOCAL_VERSIONS=1   # keep a copy of local files overwritten from the remote
MAX_REPO_DEPTH=8        # how deep to look for .git directories
FAIL_THRESHOLD=3        # consecutive failures before the first alert
REMIND_EVERY=60         # after that, remind once every N failures
QUIET_SECONDS=15        # don't start while a file was written this recently
MAX_QUIET_SKIPS=5       # ...but never postpone more runs than this in a row
CONFLICT_RACE_SECONDS=120  # conflicts closer together than this look like a race
TRANSFERS=8
CHECKERS=16
NOTIFY=1
LOG_MAX_MB=50           # rotate the log once it grows past this; 0 = never
LOG_KEEP=3              # rotated generations to keep (loudsync.log.1 .. .N)

if [ -f "${CONFIG_FILE}" ]; then
    # shellcheck source=/dev/null
    . "${CONFIG_FILE}"
else
    echo "loudsync: no config file at ${CONFIG_FILE}" >&2
    echo "Run install.sh, or copy config/loudsync.conf.example there." >&2
    exit 1
fi

# Expand a leading ~ so the config file can be written the way people think.
LOCAL_DIR="${LOCAL_DIR/#\~/${HOME}}"

# Finding rclone is worth doing properly: systemd --user starts with a minimal
# PATH, and a per-user install in ~/.local/bin is the common case.
if [ -z "${RCLONE_BIN}" ]; then
    for candidate in "${HOME}/.local/bin/rclone" /usr/bin/rclone /usr/local/bin/rclone; do
        [ -x "${candidate}" ] && { RCLONE_BIN="${candidate}"; break; }
    done
    [ -z "${RCLONE_BIN}" ] && RCLONE_BIN="$(command -v rclone || true)"
fi

FILTERS="${STATE_HOME}/filters-generated.txt"
LOG="${STATE_HOME}/loudsync.log"
LOCK="${STATE_HOME}/loudsync.lock"
FAILURES="${STATE_HOME}/consecutive-failures"
# Plain-language reason for the current failure streak, when the log names
# one. Shown by --status, cleared by the next good run.
FAIL_CAUSE="${STATE_HOME}/last-failure-cause"

# Memory of the last good run's filters, so that when rclone refuses to run we
# can say exactly what changed instead of reconstructing it afterwards.
REPOS_CURRENT="${STATE_HOME}/repos-current.txt"
REPOS_PREVIOUS="${STATE_HOME}/repos-previous.txt"
BASE_MD5="${STATE_HOME}/filters-base.md5"

# How many runs in a row were postponed because the folder was being written to.
QUIET_SKIPS="${STATE_HOME}/quiet-skips"

# Files that were still being written while the previous run was uploading
# them. Kept because they are the evidence that a conflict on the NEXT run is
# this machine racing itself rather than an edit from somewhere else.
RACED="${STATE_HOME}/raced-files.txt"
RACE_SCAN_LIMIT=500     # how many transferred files to check for mid-run edits

TODAY="$(date +%Y-%m-%d)"
# Versioned copies of local files that were overwritten by the remote.
#
# This covers the one case nothing else covers: a change pulled from the remote
# overwriting your local version. The remote's own trash and revision history
# don't help there, because the file that got overwritten is yours.
#
# The remote side is deliberately NOT versioned (no --backup-dir2): most
# providers already keep revisions and a trash bin, so duplicating that only
# burns quota and grows a dated folder nobody will ever prune.
LOCAL_VERSIONS_DIR="${STATE_HOME}/versions/${TODAY}"

mkdir -p "${STATE_HOME}" "${CONFIG_HOME}"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" >>"${LOG}"; }

# Rotate the log by size, keeping a few generations.
#
# A failure that repeats every two minutes writes the same delta over and over:
# the author's log reached 405 MB in two days that way. A log that size is one
# nobody opens, which defeats the point of writing it. Called once per run,
# under the lock, before anything is written.
rotate_log() {
    local max_bytes size i
    [ "${LOG_MAX_MB}" -gt 0 ] || return 0
    max_bytes=$(( LOG_MAX_MB * 1024 * 1024 ))
    size="$(stat -c %s "${LOG}" 2>/dev/null || echo 0)"
    [ "${size}" -gt "${max_bytes}" ] || return 0
    i="${LOG_KEEP}"
    while [ "${i}" -gt 1 ]; do
        if [ -f "${LOG}.$(( i - 1 ))" ]; then
            mv -f "${LOG}.$(( i - 1 ))" "${LOG}.${i}"
        fi
        i=$(( i - 1 ))
    done
    mv -f "${LOG}" "${LOG}.1"
    log "Log rotated at $(( size / 1024 / 1024 )) MB; the previous one is ${LOG}.1"
}

read_failures() { cat "${FAILURES}" 2>/dev/null || echo 0; }

# Desktop alert. This exists because the author's previous backup was dead for
# a month without anyone noticing.
notify() {
    local urgency="$1" title="$2" body="$3" icon="$4"
    [ "${NOTIFY}" -eq 1 ] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0
    # systemd --user does not always inherit these two, and notify-send is
    # useless without them.
    export DISPLAY="${DISPLAY:-:0}"
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
    notify-send -u "${urgency}" -i "${icon}" -a "loudsync" \
        "${title}" "${body}" 2>/dev/null || true
}

# Being offline is normal on a laptop and is not a failure worth alerting on.
have_network() { ping -c1 -W2 8.8.8.8 >/dev/null 2>&1; }

# True if any file that would be synced was written in the last QUIET_SECONDS.
#
# Syncing a folder somebody is typing into is how you manufacture conflicts out
# of nothing: bisync records in its listing the version it SAW while building
# the listing, but uploads the version it READS seconds later. When those two
# differ, the remote no longer matches the listing, so on the next run BOTH
# sides look changed and a file that only ever existed on one machine gets
# resolved as a conflict against itself.
#
# Directories are pruned by name rather than from the filter file: the point is
# to spot a human editing a document, and a build directory or a repo churning
# in the background would otherwise postpone every run forever.
HOT_FILE=""
folder_is_hot() {
    local ref hit
    ref="${STATE_HOME}/quiet-reference"
    # A reference file instead of find's relative-date syntax, which is a GNU
    # extension. -newer is in every find there is.
    if ! touch -d "@$(( $(date +%s) - QUIET_SECONDS ))" "${ref}" 2>/dev/null; then
        log "Could not build the quiet-check reference file; syncing without that check."
        return 1
    fi
    hit="$( cd "${LOCAL_DIR}" && find . \
        \( -name .git -o -name node_modules -o -name .venv -o -name venv \
           -o -name __pycache__ -o -name .mypy_cache -o -name .pytest_cache \
           -o -name .ruff_cache -o -name .cache -o -name .claude \) -prune \
        -o -type f -newer "${ref}" -print -quit 2>/dev/null )"
    HOT_FILE="${hit#./}"
    [ -n "${hit}" ]
}

die() { log "ERROR: $*"; echo "loudsync: $*" >&2; exit 1; }

# --- Preflight --------------------------------------------------------------

[ -n "${LOCAL_DIR}" ] || die "LOCAL_DIR is not set in ${CONFIG_FILE}"
[ -n "${REMOTE}" ]    || die "REMOTE is not set in ${CONFIG_FILE}"
[ -n "${RCLONE_BIN}" ] && [ -x "${RCLONE_BIN}" ] || die "rclone not found. Install it from https://rclone.org/install/"
[ -d "${LOCAL_DIR}" ] || die "local folder does not exist: ${LOCAL_DIR}"
[ -f "${FILTERS_BASE}" ] || die "missing filter file: ${FILTERS_BASE}"

REMOTE_NAME="${REMOTE%%:*}"
if ! "${RCLONE_BIN}" listremotes 2>/dev/null | grep -q "^${REMOTE_NAME}:"; then
    die "rclone remote '${REMOTE_NAME}' is not configured. Run: rclone config"
fi

# --- Status -----------------------------------------------------------------

if [ "${1:-}" = "--status" ]; then
    echo "loudsync ${VERSION}"
    echo "  local:    ${LOCAL_DIR}"
    echo "  remote:   ${REMOTE}"
    echo "  rclone:   ${RCLONE_BIN}"
    echo "  config:   ${CONFIG_FILE}"
    echo "  log:      ${LOG}"
    echo "  failures: $(read_failures) in a row"
    if [ "$(read_failures)" -gt 0 ] && [ -s "${FAIL_CAUSE}" ]; then
        echo "  why it is failing:"
        sed 's/^/    /' "${FAIL_CAUSE}"
    fi
    if [ -s "${REPOS_PREVIOUS}" ]; then
        echo "  excluded git repos: $(wc -l <"${REPOS_PREVIOUS}")"
    fi
    SKIPPED="$(cat "${QUIET_SKIPS}" 2>/dev/null || echo 0)"
    if [ "${SKIPPED}" -gt 0 ]; then
        echo "  postponed: ${SKIPPED} run(s) in a row, the folder is being written to"
    fi
    if [ -f "${LOG}" ]; then
        # The rotated log first, so the newest line wins when the current one
        # is still young. Only files that exist: under pipefail, grep failing
        # on a missing file would turn a line it did find into "never".
        LOG_FILES=()
        for f in "${LOG}.1" "${LOG}"; do
            if [ -f "${f}" ]; then LOG_FILES+=("${f}"); fi
        done
        echo "  last run: $(grep -hE '===== (DONE|FAILED)' "${LOG_FILES[@]}" | tail -1 || echo 'never')"
        echo "  last conflict: $(grep -hE '===== CONFLICT' "${LOG_FILES[@]}" | tail -1 || echo 'none recorded')"
    fi

    # Conflict copies pile up silently and every one of them is a decision
    # somebody still owes the tool. Surfacing them is the whole point.
    PENDING="$( cd "${LOCAL_DIR}" && find . \
        \( -name .git -o -name node_modules \) -prune \
        -o -type f \( -name '*.conflict-local' -o -name '*.conflict-remote' \) -print 2>/dev/null )"
    if [ -n "${PENDING}" ]; then
        echo "  unresolved conflict copies: $(printf '%s\n' "${PENDING}" | wc -l)"
        printf '%s\n' "${PENDING}" | sed 's|^\./|    |' | head -10
        echo "    (compare each with the file next to it, then delete the one you don't want)"
    fi
    exit 0
fi

if [ "${1:-}" = "--version" ]; then
    echo "loudsync ${VERSION}"
    exit 0
fi

# One instance at a time: the watcher and the timer can easily collide.
exec 9>"${LOCK}"
if ! flock -n 9; then
    log "A sync is already running; skipping this one."
    exit 0
fi

rotate_log

DRY=0
WANTS_RESYNC=0
RENAME_MODE=0
FORCE_NOW=0
YES_ARGS=()
ARGS=()
for arg in "$@"; do
    case "${arg}" in
        --dry-run|-n)       DRY=1;         ARGS+=("${arg}") ;;
        --resync)           WANTS_RESYNC=1; ARGS+=("${arg}") ;;
        --propagate-rename) RENAME_MODE=1 ;;
        --now)              FORCE_NOW=1 ;;
        --yes|-y)           YES_ARGS=(--yes) ;;
        *)                                 ARGS+=("${arg}") ;;
    esac
done

# --- Don't sync a folder that is being written to ---------------------------
#
# Postponing a run costs a minute of latency. Starting one mid-edit costs a
# conflict against yourself, a renamed copy on the remote, and a file on your
# disk that looks like somebody else edited it. The trade is not close.
#
# It is a reduction, not a cure: a save landing after the run starts still
# races. What it removes is the common case, which is the run that starts
# *while* you are typing.
#
# The cap matters as much as the check. A folder with something permanently
# writing into it must never be able to postpone backups forever, so after
# MAX_QUIET_SKIPS the run goes ahead and says why.
QUIET_SKIPPED="$(cat "${QUIET_SKIPS}" 2>/dev/null || echo 0)"
if [ "${QUIET_SECONDS}" -gt 0 ] && [ "${DRY}" -eq 0 ] && [ "${WANTS_RESYNC}" -eq 0 ] \
   && [ "${RENAME_MODE}" -eq 0 ] && [ "${FORCE_NOW}" -eq 0 ] && folder_is_hot; then
    if [ "${QUIET_SKIPPED}" -lt "${MAX_QUIET_SKIPS}" ]; then
        QUIET_SKIPPED=$(( QUIET_SKIPPED + 1 ))
        echo "${QUIET_SKIPPED}" >"${QUIET_SKIPS}"
        log "Still being written to (${HOT_FILE}); postponing this run (${QUIET_SKIPPED}/${MAX_QUIET_SKIPS})."
        exit 0
    fi
    log "The folder has been busy for ${MAX_QUIET_SKIPS} runs in a row (${HOT_FILE}); syncing anyway."
fi
echo 0 >"${QUIET_SKIPS}"

# --- Filters: git repos discovered on every run -----------------------------

( cd "${LOCAL_DIR}" && find . -maxdepth "${MAX_REPO_DEPTH}" -name ".git" -prune 2>/dev/null ) \
    | sed 's|^\./||; s|/\.git$||; /^$/d' | sort >"${REPOS_CURRENT}"

{
    echo "# GENERATED FILE — do not edit, it is rewritten on every run."
    echo "# Edit ${FILTERS_BASE} instead."
    echo "#"
    echo "# Git repositories, excluded automatically (their backup is the git remote):"
    sed 's|^|- /|; s|$|/**|' "${REPOS_CURRENT}"
    echo
    cat "${FILTERS_BASE}"
} >"${FILTERS}"

REPO_COUNT=$(wc -l <"${REPOS_CURRENT}")

# --- When the filters change ------------------------------------------------
#
# rclone bisync stores a hash of the filter file and ABORTS if it changes: a
# different filter could make it read an exclusion as a mass deletion. Since
# the repo list is regenerated on every run, a single new repo used to leave
# the sync dead until somebody ran --resync by hand.
#
# The two situations don't carry the same risk, so they aren't treated alike:
#
#   Repos were only ADDED  ->  automatic --resync. This is safe: excluding a
#     folder deletes nothing on the other side, it just stops being synced.
#
#   A repo LEFT the list, or the base filter file was edited  ->  reconcile
#     automatically as well, but never blindly. A path that disappears is
#     usually a rename, and a --resync run before the remote has been told
#     about it pulls the old-named folder back down and leaves you with both
#     copies. So the rename is propagated to the remote first (server-side, no
#     data moves) and only then reconciled. That is loudsync-rename --auto.
#
#     This used to stop and wait for a human instead. That was the wrong
#     trade. What the stop avoided is a nuisance: --resync unions both sides,
#     so a file deleted on purpose since the last run can come back, which you
#     can see and undo. What the stop cost is unbounded: a backup sitting dead
#     until somebody happens to read a notification — the exact failure this
#     tool was written to prevent.
#     (Changed 27-07-2026, after a folder move stopped the sync for a case the
#     helper could prove was a no-op.)
#
#     A human is still asked when the plan is too large to apply unattended,
#     or when one side lists no files at all. See the caps in loudsync-rename.
AUTO_RESYNC=0
MANUAL_REASON=""
RECONCILE_REASON=""
RENAMES_APPLIED=0
UNMATCHED_REMOTE=0
UNMATCHED_LOCAL=0
UNDO_FILE=""
HELPER_STATUS=0
BASE_MD5_NOW="$(md5sum "${FILTERS_BASE}" | cut -d' ' -f1)"
BASE_MD5_PREV="$(cat "${BASE_MD5}" 2>/dev/null || true)"

HELPER="$(dirname "$(readlink -f "$0")")/loudsync-rename"

# Runs the helper unattended, folding everything it prints into the log — this
# happens with nobody watching, so the log is the only record of what was done
# and why. Sets HELPER_STATUS, RENAMES_APPLIED and UNDO_FILE.
run_rename_helper() {
    local output line
    [ -f "${HELPER}" ] || die "missing helper: ${HELPER}"
    set +e
    output="$(python3 "${HELPER}" "${RCLONE_BIN}" "${LOCAL_DIR}" "${REMOTE}" \
        "${FILTERS}" --state-dir "${STATE_HOME}" "$@" 2>&1)"
    HELPER_STATUS=$?
    set -e
    while IFS= read -r line; do
        if [ -n "${line}" ]; then log "  rename | ${line}"; fi
    done <<<"${output}"
    UNDO_FILE="$(printf '%s\n' "${output}" | sed -n 's/^LOUDSYNC-UNDO //p' | tail -1)"
    RENAMES_APPLIED="$(summary_field "${output}" moves)"
    UNMATCHED_REMOTE="$(summary_field "${output}" unmatched_remote)"
    UNMATCHED_LOCAL="$(summary_field "${output}" unmatched_local)"
}

# Pulls one number out of the helper's LOUDSYNC-SUMMARY line, 0 if absent.
summary_field() {
    local value
    value="$(printf '%s\n' "$1" \
        | sed -n "s/^LOUDSYNC-SUMMARY .*$2=\([0-9]\{1,\}\).*/\1/p" | tail -1)"
    printf '%s' "${value:-0}"
}

if [ "${WANTS_RESYNC}" -eq 0 ] && [ "${RENAME_MODE}" -eq 0 ] \
   && [ -s "${REPOS_PREVIOUS}" ] && [ -n "${BASE_MD5_PREV}" ]; then
    GONE="$(comm -23 "${REPOS_PREVIOUS}" "${REPOS_CURRENT}")"
    ADDED="$(comm -13 "${REPOS_PREVIOUS}" "${REPOS_CURRENT}")"

    if [ "${BASE_MD5_NOW}" != "${BASE_MD5_PREV}" ]; then
        RECONCILE_REASON="${FILTERS_BASE} was edited"
    elif [ -n "${GONE}" ]; then
        RECONCILE_REASON="these repos left the list (renamed?): $(printf '%s' "${GONE}" | tr '\n' ' ')"
    elif [ -n "${ADDED}" ]; then
        AUTO_RESYNC=1
        log "Newly excluded repos: $(printf '%s' "${ADDED}" | tr '\n' ' ')"
        log "Filters only grew, reconciling with an automatic --resync."
    fi

    if [ -n "${RECONCILE_REASON}" ]; then
        log "Filters changed in a way that needs reconciling: ${RECONCILE_REASON}"
        if [ "${DRY}" -eq 1 ]; then
            log "--dry-run: showing the plan, applying nothing."
            run_rename_helper --auto --dry-run
        else
            run_rename_helper --auto
            case ${HELPER_STATUS} in
                0) AUTO_RESYNC=1
                   log "Reconciled automatically (${RENAMES_APPLIED} rename(s) propagated)." ;;
                3) MANUAL_REASON="${RECONCILE_REASON}"
                   log "This one is not safe to apply unattended; see the plan above." ;;
                *) # Usually an unreachable remote. Fall through without a
                   # resync: bisync will fail on the filter hash, and the normal
                   # failure path already knows not to cry about being offline.
                   log "The rename helper failed (exit ${HELPER_STATUS}); not reconciling this run." ;;
            esac
        fi
    fi

    # Alert as soon as it is detected rather than waiting for the failure
    # threshold: the generic message doesn't say what to do, and here we know.
    if [ -n "${MANUAL_REASON}" ]; then
        log "ATTENTION: sync is stopped until a human decides: ${MANUAL_REASON}"
        log "In a terminal, run:"
        log "    $0 --propagate-rename"
        log "It compares both sides, shows what it would rename on the remote,"
        log "and applies it after you confirm."
        if [ "$(read_failures)" -eq 0 ]; then
            notify critical "Sync stopped: this needs a decision" \
                "The filter list changed and the plan is too large to apply on its own. Nothing was deleted. Run in a terminal: loudsync --propagate-rename" \
                dialog-error
        fi
    fi
fi

# --- Rename propagation, interactive ----------------------------------------
#
# The same helper, driven by a human. No output capture here: it prints the
# plan and waits for an answer, so it needs the terminal.
if [ "${RENAME_MODE}" -eq 1 ]; then
    [ -f "${HELPER}" ] || die "missing helper: ${HELPER}"
    log "Running --propagate-rename."
    set +e
    python3 "${HELPER}" "${RCLONE_BIN}" "${LOCAL_DIR}" "${REMOTE}" "${FILTERS}" \
        --state-dir "${STATE_HOME}" "${YES_ARGS[@]}"
    HELPER_STATUS=$?
    set -e
    case ${HELPER_STATUS} in
        0) AUTO_RESYNC=1
           log "Renames are up to date, reconciling with --resync." ;;
        2) log "Cancelled by the user, nothing was touched."
           exit 0 ;;
        *) log "Rename propagation failed (exit ${HELPER_STATUS})."
           exit 1 ;;
    esac
fi

# Written as an if rather than "cond && EXTRA=(...)": under set -e, an && list
# whose result is false terminates the script.
EXTRA=()
if [ "${AUTO_RESYNC}" -eq 1 ]; then
    EXTRA=(--resync --resync-mode newer)
fi

BACKUP=()
if [ "${KEEP_LOCAL_VERSIONS}" -eq 1 ]; then
    BACKUP=(--backup-dir1 "${LOCAL_VERSIONS_DIR}")
fi

# bisync refuses to start if the remote path doesn't exist yet, which makes a
# first run fail with a confusing "directory not found". Create it — but only
# on an explicit resync. During a normal run a missing remote path means
# something actually went wrong, and papering over that would hide it.
if [ "${WANTS_RESYNC}" -eq 1 ] || [ "${AUTO_RESYNC}" -eq 1 ]; then
    if ! "${RCLONE_BIN}" lsf --max-depth 1 "${REMOTE}" >/dev/null 2>&1; then
        log "Remote path does not exist yet, creating it: ${REMOTE}"
        echo "Creating remote path: ${REMOTE}"
        "${RCLONE_BIN}" mkdir "${REMOTE}" \
            || die "could not create remote path ${REMOTE} — check the name in ${CONFIG_FILE}"
    fi
fi

# --- Conflicts --------------------------------------------------------------
#
# rclone handles a conflict competently and then says nothing you will ever
# see: it renames the loser, copies it across, logs at INFO and exits 0. The
# run reads as a success, and the first you hear of it is a file with a strange
# suffix sitting in your folder days later, next to a copy of your document
# that is missing the last thing you wrote.
#
# That is precisely the event this tool exists to shout about. A conflict is
# the one moment where two versions of your work are both real and only a human
# can say which one counts.

# Everything rclone logged during this run. The offset is taken before the run
# because rclone appends to the same file this script writes to.
run_log_slice() {
    tail -c "+$(( LOG_OFFSET + 1 ))" "${LOG}" 2>/dev/null || true
}

# rclone prints the gap between two versions as a Go duration, and the unit
# changes with the size of the gap: "16.934994885s", "1m30s", "8h0m0s",
# "500ms". Reading the leading number and assuming seconds is how you file an
# eight-hour divergence as a two-second race — which is the one mistake here
# that points the wrong way. Prints whole seconds, or nothing if it can't tell.
duration_seconds() {
    printf '%s' "$1" | awk '
    BEGIN { u["h"]=3600; u["m"]=60; u["s"]=1
            u["ms"]=0.001; u["us"]=0.000001; u["µs"]=0.000001; u["ns"]=1e-9 }
    {
        s = $0; sub(/^-/, "", s); total = 0; ok = 0
        while (length(s) > 0) {
            if (!match(s, /^[0-9]+(\.[0-9]+)?/)) { ok = 0; break }
            num = substr(s, 1, RLENGTH) + 0
            s = substr(s, RLENGTH + 1)
            if (!match(s, /^(ms|ns|us|µs|h|m|s)/)) { ok = 0; break }
            unit = substr(s, 1, RLENGTH)
            s = substr(s, RLENGTH + 1)
            total += num * u[unit]
            ok = 1
        }
        if (ok) printf "%d", total
    }'
}

# A gap a person can read at a glance. The exact nanoseconds rclone reports
# tell you nothing that "16s" or "8h" does not.
human_gap() {
    local s="$1"
    if   [ "${s}" -eq 0 ];       then printf 'under a second'
    elif [ "${s}" -lt 60 ];      then printf '%ss' "${s}"
    elif [ "${s}" -lt 3600 ];    then printf '%sm' "$(( s / 60 ))"
    elif [ "${s}" -lt 86400 ];   then printf '%sh' "$(( s / 3600 ))"
    else                              printf '%sd' "$(( s / 86400 ))"
    fi
}

# The paths rclone uploaded that were written again while it was uploading
# them. Their entry in bisync's listing is now stale on both sides, which is
# exactly what makes the NEXT run see a change on a side nobody touched.
detect_raced_files() {
    local slice="$1" started="$2" copied path mtime count=0 out=""
    copied="$(printf '%s\n' "${slice}" \
        | sed -n 's/^.*INFO  : \(.*\): Copied (.*)$/\1/p' | sort -u)"
    [ -n "${copied}" ] || { : >"${RACED}"; return 0; }
    while IFS= read -r path; do
        [ -n "${path}" ] || continue
        count=$(( count + 1 ))
        if [ "${count}" -gt "${RACE_SCAN_LIMIT}" ]; then
            log "Over ${RACE_SCAN_LIMIT} files transferred; only the first ${RACE_SCAN_LIMIT} were checked for mid-run edits."
            break
        fi
        mtime="$(stat -c %Y "${LOCAL_DIR}/${path}" 2>/dev/null || echo 0)"
        if [ "${mtime}" -gt "${started}" ]; then
            out="${out}${path}"$'\n'
            log "Written to while it was being uploaded: ${path}"
            log "  Its next comparison will look like a change on both sides. It isn't one."
        fi
    done <<<"${copied}"
    printf '%s' "${out}" >"${RACED}"
}

# Reads the run's log and turns every conflict into something a human can act
# on: which file, which side won, by how much, where the other version is, and
# whether this was two people working or one machine racing itself.
report_conflicts() {
    local slice="$1" was_raced="$2"
    local paths path line winner diff loser sep rest
    local diff_show diff_whole
    local total=0 genuine=0 first="" body=""
    local flagged not_renamed=0
    declare -A WINNER_OF DIFF_OF

    flagged="$(printf '%s\n' "${slice}" \
        | sed -n 's/^.*NOTICE: - WARNING  *New or changed in both paths  *- \(.*\)$/\1/p' | sort -u)"
    [ -n "${flagged}" ] || return 0

    # That warning is raised BEFORE rclone compares the two versions. When they
    # turn out identical (both sides already had the same upload and only the
    # listing was behind) it logs "Files are equal! Skipping" and renames
    # nothing; directories are never renamed at all. A conflict is a renamed
    # loser, so that rename line is what counts. Counting the warnings instead
    # once announced 266 conflicts of which zero existed (19-09-2026), which is
    # exactly the alarm that teaches you to stop reading alarms.
    #
    # The rename line names the loser with its full prefix: the local folder
    # for Path1, "remote{hash}:path/" for Path2. Both are stripped and the
    # result compared whole, because a substring match confuses a path with
    # any longer path that ends the same way.
    local renamed_path remote_path
    declare -A RENAMED
    remote_path="${REMOTE#*:}"
    remote_path="${remote_path%/}"
    while IFS= read -r line; do
        case "${line}" in
            *" Renaming Path1 copy "*|*" Renaming Path2 copy "*) ;;
            *) continue ;;
        esac
        renamed_path="${line#* Renaming Path? copy }"
        renamed_path="${renamed_path#"${renamed_path%%[! ]*}"}"
        renamed_path="${renamed_path#- }"
        case "${line}" in
            *" Renaming Path1 copy "*)
                renamed_path="${renamed_path#"${LOCAL_DIR%/}/"}" ;;
            *)
                renamed_path="${renamed_path#*:}"
                if [ -n "${remote_path}" ]; then
                    renamed_path="${renamed_path#"${remote_path}/"}"
                fi ;;
        esac
        renamed_path="${renamed_path%.conflict-local}"
        renamed_path="${renamed_path%.conflict-remote}"
        RENAMED["${renamed_path}"]=1
    done <<<"${slice}"

    paths=""
    while IFS= read -r path; do
        [ -n "${path}" ] || continue
        if [ -n "${RENAMED[${path}]:-}" ]; then
            paths="${paths}${path}"$'\n'
        else
            not_renamed=$(( not_renamed + 1 ))
        fi
    done <<<"${flagged}"
    if [ "${not_renamed}" -gt 0 ]; then
        log "${not_renamed} path(s) flagged as changed on both sides were identical or directories; nothing was renamed, so they are not conflicts."
    fi
    [ -n "${paths}" ] || return 0

    while IFS= read -r line; do
        case "${line}" in
            *": The winner is: Path"*)
                winner="${line##*: The winner is: }"
                rest="${line%: The winner is: *}"
                WINNER_OF["${rest#*INFO  : }"]="${winner}"
                ;;
            *", Difference: "*)
                sep=""
                case "${line}" in
                    *": Path1 is newer. "*) sep=": Path1 is newer. " ;;
                    *": Path2 is newer. "*) sep=": Path2 is newer. " ;;
                esac
                [ -n "${sep}" ] || continue
                # Kept whole. The trailing letter is the unit of a Go duration,
                # not a marker to strip: "8h0m0s" without its last character is
                # a different number, and "2h" doesn't end in s at all.
                diff="${line##*, Difference: }"
                rest="${line%%"${sep}"*}"
                DIFF_OF["${rest#*INFO  : }"]="${diff}"
                ;;
        esac
    done <<<"${slice}"

    log "===== CONFLICT ====="
    while IFS= read -r path; do
        [ -n "${path}" ] || continue
        total=$(( total + 1 ))
        winner="${WINNER_OF[${path}]:-}"
        diff="${DIFF_OF[${path}]:-}"

        # --conflict-suffix is local,remote in that order, so the losing copy
        # carries the suffix of the side it came from. Both sides end up with
        # both files, so the path below is one you can open right now.
        case "${winner}" in
            Path1) loser="${path}.conflict-remote" ;;
            Path2) loser="${path}.conflict-local"  ;;
            *)     loser="" ;;
        esac

        log "Changed on both sides since the last run: ${path}"

        diff_show=""
        diff_whole=""
        if [ -n "${diff}" ]; then
            diff_whole="$(duration_seconds "${diff}")"
            if [ -n "${diff_whole}" ]; then
                diff_show="$(human_gap "${diff_whole}")"
            else
                # Unreadable: say so, show it verbatim, and let the file fall
                # through to being treated as a real divergence. Guessing in the
                # quiet direction is how a conflict goes unnoticed.
                diff_show="${diff}"
                log "  (could not read the time gap rclone reported: ${diff})"
            fi
        fi

        case "${winner}" in
            Path1) log "  Your local copy won${diff_show:+ by ${diff_show}} and was uploaded." ;;
            Path2) log "  The remote copy won${diff_show:+ by ${diff_show}} and replaced your local file." ;;
            *)     log "  No winner was chosen; both versions were kept." ;;
        esac
        if [ -n "${loser}" ]; then
            log "  The other version is kept as: ${LOCAL_DIR}/${loser}"
        fi

        # Two versions seconds apart are almost never two people working. They
        # are one file that was saved while a run was in flight — which this
        # tool can often prove, because it watched it happen last run.
        if printf '%s\n' "${was_raced}" | grep -qxF -- "${path}"; then
            log "  This file was written to while the previous run was uploading it, so"
            log "  this is not an edit from another machine — it is the same file racing itself."
        elif [ -n "${diff_whole}" ] && [ "${diff_whole}" -lt "${CONFLICT_RACE_SECONDS}" ]; then
            log "  The two versions are ${diff_show} apart, which usually means the file was saved"
            log "  while a sync was running rather than edited in two places."
        else
            genuine=$(( genuine + 1 ))
            log "  The two versions are far apart in time. Treat this as a real divergence:"
            log "  compare both files before deleting either one."
        fi
        if [ -z "${first}" ]; then first="${path##*/}"; fi
    done <<<"${paths}"
    log "===== CONFLICT (${total} file(s), ${genuine} needing a decision) ====="

    # Loud, but calibrated. Crying wolf over the self-inflicted race is how a
    # notification becomes something you dismiss without reading.
    body="${first}"
    if [ "${total}" -gt 1 ]; then
        body="${first} and $(( total - 1 )) more"
    fi
    if [ "${genuine}" -gt 0 ]; then
        notify critical "Conflict: two versions of your work" \
            "${body} changed on both sides and only you can say which is right. Both were kept, side by side. Details: loudsync --status" \
            dialog-warning
    else
        notify normal "Conflict resolved: ${total} file(s)" \
            "${body} was saved while a sync was running, so the newer version won and the older one was kept beside it. Nothing was lost. See: loudsync --status" \
            emblem-default
    fi
}

# --- Sync -------------------------------------------------------------------

log "===== START (${REPO_COUNT} repos excluded) ====="

LOG_OFFSET="$(stat -c %s "${LOG}" 2>/dev/null || echo 0)"
RUN_STARTED="$(date +%s)"
WAS_RACED="$(cat "${RACED}" 2>/dev/null || true)"

set +e
"${RCLONE_BIN}" bisync "${LOCAL_DIR}" "${REMOTE}" \
    --filters-file "${FILTERS}" \
    --conflict-resolve "${CONFLICT_RESOLVE}" \
    --conflict-loser pathname \
    --conflict-suffix conflict-local,conflict-remote \
    --max-delete "${MAX_DELETE_PERCENT}" \
    --recover \
    --resilient \
    --drive-skip-gdocs \
    --create-empty-src-dirs \
    --transfers "${TRANSFERS}" \
    --checkers "${CHECKERS}" \
    --log-file "${LOG}" \
    --log-level INFO \
    "${BACKUP[@]}" "${EXTRA[@]}" "${ARGS[@]}"
STATUS=$?
set -e

PREVIOUS=$(read_failures)

if [ ${STATUS} -eq 0 ]; then
    log "===== DONE ====="

    # Exit 0 is not the same as "nothing happened". A dry run only prints what
    # it would do, so there is nothing to report and nothing to remember.
    if [ "${DRY}" -eq 0 ]; then
        SLICE="$(run_log_slice)"
        report_conflicts "${SLICE}" "${WAS_RACED}"
        detect_raced_files "${SLICE}" "${RUN_STARTED}"
    fi

    # The filter snapshot is saved only after a run that actually worked, and
    # never after a dry run: saving it otherwise would compare the next change
    # against a state rclone never accepted.
    if [ "${DRY}" -eq 0 ]; then
        cp -f "${REPOS_CURRENT}" "${REPOS_PREVIOUS}"
        printf '%s\n' "${BASE_MD5_NOW}" >"${BASE_MD5}"
    fi

    if [ "${AUTO_RESYNC}" -eq 1 ]; then
        NOTE_TITLE="Sync exclusions updated"

        # Naming the actual reason costs one line. Reporting an edit you made
        # to the filter file as "the git repository exclusions changed" is a
        # small lie, and small lies in notifications are how people stop
        # reading them.
        case "${RECONCILE_REASON}" in
            *"was edited")
                NOTE_BODY="Your filter file was edited, so the sync reconciled itself. Nothing was deleted." ;;
            *repos*)
                NOTE_BODY="A folder holding a git repo moved, so the sync reconciled itself. Nothing was deleted." ;;
            *)
                NOTE_BODY="The git repository exclusions changed and the sync reconciled itself. Nothing was deleted." ;;
        esac

        # A rename on the remote is a change you didn't make by hand, so say so
        # and say how to take it back.
        if [ "${RENAMES_APPLIED}" -gt 0 ]; then
            NOTE_TITLE="Renames propagated, sync reconciled"
            NOTE_BODY="${RENAMES_APPLIED} rename(s) applied on the remote so the sync could continue on its own. To reverse them: ${UNDO_FILE}"
        fi

        # A --resync unions both sides, so a file deleted on purpose since the
        # last run can reappear. That is the one thing this path can do behind
        # your back, so it gets counted out loud instead of living in the log.
        UNMATCHED_TOTAL=$(( UNMATCHED_REMOTE + UNMATCHED_LOCAL ))
        if [ "${UNMATCHED_TOTAL}" -gt 0 ]; then
            NOTE_BODY="${NOTE_BODY} ${UNMATCHED_TOTAL} file(s) existed on only one side and were settled by date, so anything you deleted on purpose since the last run may be back. They are listed in ${LOG}"
        fi

        # A desktop notification is gone the moment you dismiss it. What it said
        # about a remote this script changed on its own belongs in the log too.
        log "Notified: ${NOTE_TITLE} — ${NOTE_BODY}"
        notify normal "${NOTE_TITLE}" "${NOTE_BODY}" emblem-default
    fi

    # If it had been failing long enough to alert, say that it recovered: an
    # alarm with no all-clear trains people to ignore alarms.
    if [ "${PREVIOUS}" -ge "${FAIL_THRESHOLD}" ]; then
        notify normal "Sync is back" \
            "Syncing recovered after ${PREVIOUS} failed attempts." \
            emblem-default
        log "Recovered after ${PREVIOUS} consecutive failures."
    fi
    echo 0 >"${FAILURES}"
    rm -f "${FAIL_CAUSE}"
else
    log "===== FAILED (exit=${STATUS}) ====="
    log "If the state is out of step, reconcile with: $0 --resync"

    # Some failures have one specific cause the generic alert cannot name.
    # Files inside the synced tree that belong to another account (someone
    # uploaded them straight into a shared folder) cannot be deleted or
    # trashed by anyone but their owner: the provider answers 403, bisync
    # aborts, and it will abort again on every run until a human moves them
    # out. The author's sync sat dead for 37 hours over seven such files
    # while the alert said only "check the log". Name the cause, name the
    # files, say what to do.
    FOREIGN="$(run_log_slice \
        | sed -n "s/^.*ERROR : \(.*\): Couldn't [a-z]*: .*403.*insufficientFilePermissions.*\$/\1/p" \
        | sort -u)"
    CAUSE_TITLE=""
    CAUSE_BODY=""
    if [ -n "${FOREIGN}" ]; then
        FOREIGN_COUNT="$(printf '%s\n' "${FOREIGN}" | wc -l)"
        FOREIGN_FIRST="$(printf '%s\n' "${FOREIGN}" | head -1)"
        {
            echo "${FOREIGN_COUNT} file(s) on the remote belong to another account, so this one cannot delete them (403 insufficientFilePermissions):"
            printf '%s\n' "${FOREIGN}" | sed 's/^/  /'
            echo "The sync will fail on every run until they are out of the synced tree: remove them from the folder in your provider's web interface, or ask their owner to delete them."
        } >"${FAIL_CAUSE}"
        while IFS= read -r line; do log "  cause | ${line}"; done <"${FAIL_CAUSE}"
        CAUSE_TITLE="Sync blocked by files you don't own"
        CAUSE_BODY="${FOREIGN_FIRST##*/}"
        if [ "${FOREIGN_COUNT}" -gt 1 ]; then
            CAUSE_BODY="${CAUSE_BODY} and $(( FOREIGN_COUNT - 1 )) more"
        fi
        CAUSE_BODY="${CAUSE_BODY} belong(s) to another account and can't be deleted from here, so every run fails. Move them out of the synced folder in your provider's web interface, or ask the owner to delete them. Details: loudsync --status"
    fi

    if ! have_network; then
        log "No network: not counted as a failure."
    else
        N=$(( PREVIOUS + 1 ))
        echo "${N}" >"${FAILURES}"
        log "Consecutive failure number ${N} (with network available)."

        # Alert at the threshold, then once an hour, so it doesn't become
        # noise that gets learned away.
        if [ "${N}" -eq "${FAIL_THRESHOLD}" ] \
           || { [ "${N}" -gt "${FAIL_THRESHOLD}" ] && [ $(( N % REMIND_EVERY )) -eq 0 ]; }; then
            if [ -n "${CAUSE_TITLE}" ]; then
                notify critical "${CAUSE_TITLE}" "${CAUSE_BODY}" dialog-error
            else
                notify critical "Sync is not running" \
                    "${N} failed attempts in a row. Check: tail -40 ${LOG}" \
                    dialog-error
            fi
        fi
    fi
fi

exit ${STATUS}
